{
  "name": "GenerationJob",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "validating",
        "generating",
        "qa",
        "repairing",
        "passed",
        "failed",
        "doc_created"
      ],
      "default": "pending"
    },
    "prompt_version": {
      "type": "number"
    },
    "required_model": {
      "type": "string",
      "default": "gpt-5.6-sol"
    },
    "actual_model": {
      "type": "string"
    },
    "sources_signature": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "qa_results": {
      "type": "object",
      "additionalProperties": true
    },
    "scripts": {
      "type": "object",
      "additionalProperties": true
    },
    "validation_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d1\u05dc\u05d1\u05d3 \u2014 \u05d0\u05d9\u05e0\u05d5 \u05d7\u05d5\u05e1\u05dd"
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05d5\u05e6\u05d0\u05ea \u05d4-QA \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea \u05d5\u05d4\u05e1\u05d5\u05e4\u05d9\u05ea \u05d1\u05dc\u05d1\u05d3. \u05de\u05d7\u05d5\u05e9\u05d1 \u05de\u05d7\u05d3\u05e9 \u05d1\u05db\u05dc \u05e8\u05d9\u05e6\u05ea QA \u05d5\u05d0\u05d9\u05e0\u05d5 \u05db\u05d5\u05dc\u05dc \u05e9\u05d2\u05d9\u05d0\u05d5\u05ea \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05e9\u05ea\u05d5\u05e7\u05e0\u05d5"
    },
    "documentation_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d9\u05d3\u05e2 \u05e9\u05dc\u05d0 \u05e0\u05de\u05e6\u05d0 \u05d0\u05d5 \u05dc\u05d0 \u05d0\u05d5\u05de\u05ea \u05d1\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d5\u05dc\u05db\u05df \u05d4\u05d5\u05e9\u05de\u05d8 \u05de\u05d4\u05e7\u05e8\u05d9\u05d9\u05e0\u05d5\u05ea. \u05d0\u05d9\u05e0\u05d5 \u05d7\u05d5\u05e1\u05dd \u05d5\u05d0\u05d9\u05e0\u05d5 \u05db\u05d5\u05dc\u05dc \u05d4\u05e2\u05e8\u05d5\u05ea \u05e1\u05d2\u05e0\u05d5\u05df"
    },
    "writer_blocking_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d4\u05e4\u05e8\u05d5\u05ea \u05d0\u05de\u05ea \u05e9\u05d3\u05d5\u05d5\u05d7\u05d5 \u05d1\u05e9\u05dc\u05d1 \u05d4\u05db\u05ea\u05d9\u05d1\u05d4 \u05d1\u05dc\u05d1\u05d3"
    },
    "writer_documentation_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e4\u05e2\u05e8\u05d9 \u05ea\u05d9\u05e2\u05d5\u05d3 \u05e9\u05d3\u05d5\u05d5\u05d7\u05d5 \u05d1\u05e9\u05dc\u05d1 \u05d4\u05db\u05ea\u05d9\u05d1\u05d4 \u05d1\u05dc\u05d1\u05d3"
    },
    "qa_style_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e1\u05d2\u05e0\u05d5\u05df \u05d5\u05dc\u05d9\u05d8\u05d5\u05e9 \u05e9\u05d0\u05d9\u05e0\u05df \u05d7\u05d5\u05e1\u05de\u05d5\u05ea \u05d5\u05d0\u05d9\u05e0\u05df \u05e4\u05e2\u05e8\u05d9 \u05ea\u05d9\u05e2\u05d5\u05d3"
    },
    "qa_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d0\u05d6\u05d4\u05e8\u05d5\u05ea \u05ea\u05d4\u05dc\u05d9\u05da QA (batch \u05e9\u05e0\u05db\u05e9\u05dc, \u05ea\u05d9\u05e7\u05d5\u05df \u05e9\u05dc\u05d0 \u05d4\u05d5\u05e9\u05dc\u05dd) \u2014 \u05d0\u05d9\u05e0\u05df \u05d7\u05d5\u05e1\u05de\u05d5\u05ea"
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
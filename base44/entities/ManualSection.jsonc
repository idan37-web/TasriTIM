{
  "name": "ManualSection",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "page": {
      "type": "number"
    },
    "heading": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "order_index": {
      "type": "number"
    }
  },
  "required": [
    "project_id",
    "document_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
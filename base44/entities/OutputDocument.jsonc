{
  "name": "OutputDocument",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "google_doc_id": {
      "type": "string"
    },
    "doc_url": {
      "type": "string"
    },
    "folder_id": {
      "type": "string"
    },
    "folder_name": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
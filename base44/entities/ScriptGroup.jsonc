{
  "name": "ScriptGroup",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "system_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order_index": {
      "type": "number",
      "default": 1
    },
    "user_modified": {
      "type": "boolean",
      "default": false
    },
    "script_type": {
      "type": "string",
      "enum": [
        "general",
        "focused"
      ],
      "default": "focused"
    },
    "cancelled": {
      "type": "boolean",
      "default": false
    },
    "merge_reason": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}